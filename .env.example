# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Memoria: ruta en disco persistente del worker. Vacío mantiene el pipeline actual.
# No usar almacenamiento efímero de Vercel/Actions como memoria permanente.
REGTRACK_KNOWLEDGE_DIR=
# Web: filesystem (por defecto) o supabase. Activar tras aplicar la migración de memoria.
REGTRACK_MEMORY_BACKEND=
# Worker: 1 sincroniza al terminar; exige un vault local. --scan-only nunca escribe en BD.
REGTRACK_MEMORY_SYNC=
REGTRACK_INTEGRATIONS_CONFIG=integrations/config.local.json
OPENALEPH_API_KEY=
CHANGEDETECTION_API_KEY=
GRAPHITI_MCP_TOKEN=
